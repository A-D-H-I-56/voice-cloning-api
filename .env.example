# Copy this file to .env and adjust values as needed.
# ⚠️ NEVER commit .env to git — it contains sensitive credentials

# ============================================================================
# MongoDB Connection
# ============================================================================
# For MongoDB Atlas: Get connection string from cluster dashboard
# Example: mongodb+srv://username:password@cluster.mongodb.net/dbname?ssl=true...
# For local MongoDB: mongodb://username:password@localhost:27017/dbname
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?ssl=true...
# MongoDB database name
DB_NAME=voice-cloning

# ============================================================================
# Security
# ============================================================================
# API Key for authentication. Generate a strong key:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-secret-api-key-here-change-in-production

# Enable debug mode (NEVER in production!)
DEBUG=false

# ============================================================================
# Storage Directories
# ============================================================================
# Storage directories (relative to the project root / container WORKDIR)
CHECKPOINTS_DIR=checkpoints
OUTPUTS_DIR=outputs

# ============================================================================
# TTS Configuration
# ============================================================================
# XTTS-v2 model identifier (change only if you want to use a different TTS model)
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# Audio sample rate produced by XTTS-v2 (do not change unless you switch models)
SAMPLE_RATE=24000

# Maximum file upload size in MB
MAX_FILE_SIZE_MB=50

# ============================================================================
# Rate Limiting
# ============================================================================
# Max API requests per minute per IP
RATE_LIMIT_REQUESTS=10

# Rate limit window in seconds
RATE_LIMIT_WINDOW=60

# ============================================================================
# Coqui TTS License
# ============================================================================
# Coqui TTS non-commercial CPML licence agreement.
# Set to "1" to auto-accept and suppress the interactive prompt on first model download.
# https://coqui.ai/cpml
COQUI_TOS_AGREED=1
